def extract_bam(sample, libdir, umi = False):
    """
    """
    project = sample.split("-")[0]

    if project == "AL":
        sample_capture_str = compose_lib_capture_str(extract_unique_capture(sample))
        pattern = libdir + "/" + sample_capture_str + "*nodups.bam"
    
    if project in ["PB", "LB"]:
        pattern = libdir + "/" + sample + "*nodups.bam"
        umibam_pattern = libdir + "/" + sample + "*clipoverlap.bam"
    
    if umi:
        umi_bam  = glob.glob(umibam_pattern)
        if len(umi_bam) == 1:
            return umi_bam[0]
        else:
            raise ValueError("Invalid UMI bam search: " + sample)

    nodups_bam = glob.glob(pattern)
    if len(nodups_bam) == 1:
        return nodups_bam[0]
    else:
        raise ValueError(" ".join(["Invalid bam : ", sample, nodups_bam]))


