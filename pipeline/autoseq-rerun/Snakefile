### Extract bam files for downstream process

capture_to_results = collections.defaultdict(SinglePanelResults)
BAM_FILES = list()
capture_to_results[NORMAL_CAPTURE].bamfile = extract_bamfiles(normal_sample, libdir) 
capture_to_results[CANCER_CAPTURE].bamfile = extract_bamfiles(cancer_sample, libdir) 
BAM_FILES.append(capture_to_results[NORMAL_CAPTURE].bamfile)
BAM_FILES.append(capture_to_results[CANCER_CAPTURE].bamfile)

if umi:
    NORMAL_UMIBAM = extract_bamfiles(normal_sample, libdir, umi) 
    CANCER_UMIBAM = extract_bamfiles(normal_sample, libdir, umi) 
    BAM_FILES.append(NORMAL_UMIBAM)
    BAM_FILES.append(CANCER_UMIBAM)

for bam in BAM_FILES:
    bname = os.path.basename(bam)
    dstdir = os.path.join(outdir, "bams")

    if not os.path.exists(dstdir):
        os.makedirs(dstdir, exist_ok=True)
    
    if not os.path.exists(os.path.join(dstdir, bname)):
        os.symlink(os.path.join(bam), os.path.join(dstdir, bname))


